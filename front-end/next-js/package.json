{
  "name": "coding-agent-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test:lifecycle": "vitest run --config vitest.lifecycle.config.mjs",
    "deps:harden": "node scripts/harden-braces.mjs",
    "deps:verify": "node scripts/harden-braces.mjs --check",
    "postinstall": "npm run deps:harden",
    "prebuild": "npm run deps:verify",
    "prelint": "npm run deps:verify",
    "pretest:lifecycle": "npm run deps:verify"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "postcss": "^8.4.38",
    "tailwindcss": "3.4.19",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser@<7": "6.1.5"
  }
}
