# --- Local Docker Compose MySQL initialization ---
# Used only by the local mysql:8.4 Compose service.
# Copy this template to .env and replace all placeholders with local,
# non-production values. Do not commit .env.
MYSQL_DATABASE=coding_agent
MYSQL_USER=coding_agent
MYSQL_PASSWORD=replace-with-a-long-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-root-password
