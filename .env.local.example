# front-end/local/.env.local.example
#
# Copy to front-end/local/.env for local development or inject at frontend
# image build time. OAuth configuration is backend-only: do not add GitHub
# or GitLab client IDs, client secrets, PKCE verifiers, or provider tokens
# to this file. The FastAPI backend owns both provider OAuth flows.

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
