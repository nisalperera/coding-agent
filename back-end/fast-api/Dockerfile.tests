FROM python:3.12-slim
WORKDIR /code
COPY requirements.txt requirements-dev.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini main.py ./
COPY tests/ ./tests/
COPY tests_support/ ./tests_support/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["sh", "-c", "python -m unittest discover -s tests_support -p 'test_*.py' -v && python -m tests_support.run_backend_suite"]
