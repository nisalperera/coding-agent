# Copy this file to .env and fill in real values.

# --- Local vLLM server (OpenAI-compatible) ---
VLLM_ENDPOINT=http://localhost:8000/v1/chat/completions
VLLM_HEALTH_ENDPOINT=http://localhost:8000/health
MODEL_NAME=Qwen/Qwen3-Coder-14B-Instruct-AWQ

# Optional: shell command this process can launch if vLLM is not already
# running. Leave unset to only wait for a server you start yourself.
# VLLM_AUTOSTART_CMD=systemctl --user start vllm

# --- Startup budget / polling ---
STARTUP_BUDGET_S=120
POLL_INTERVAL_S=3
RETRY_AFTER_S=120

# --- Rate limiting ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_S=60

# --- HTTP client ---
HTTP_TIMEOUT_S=30

# --- Web search ---
TAVILY_API_KEY=replace-me

# --- Google OAuth (replaces AWS Cognito entirely) ---
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
# GOOGLE_ALLOWED_EMAIL_DOMAIN=example.com

# --- Session / cookie signing ---
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_S=604800
OAUTH_STATE_TTL_S=600
COOKIE_SECURE=true

# --- GitHub OAuth App ("Connect GitHub") ---
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me

# --- Service-level fallback tokens for repo tools ---
GITHUB_TOKEN=
GITLAB_TOKEN=

# --- SQLite ---
SQLITE_DB_PATH=./data/app.db

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
