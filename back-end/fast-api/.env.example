# --- Runtime ---
APP_ENV=development
DEBUG=false

# --- Database ---
# --- Local Docker Compose MySQL initialization ---
# Used only by the local mysql:8.4 Compose service.
# Copy this template to .env and replace all placeholders with local,
# non-production values. Do not commit .env.
MYSQL_DATABASE=coding_agent
MYSQL_USER=coding_agent
MYSQL_PASSWORD=replace-with-a-long-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-root-password

# Required by FastAPI and the one-shot Alembic migration service.
# `mysql` is the internal Docker Compose service hostname.
DATABASE_URL=mysql+pymysql://coding_agent:replace-with-a-long-unique-password@mysql:3306/coding_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_S=1800
DATABASE_CONNECT_TIMEOUT_S=10

# --- Browser frontend and CORS ---
# Use literal comma-separated origins. Do not use Markdown, wildcards, or a trailing slash.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production and staging must set this to true and use HTTPS origins/callback URLs.
COOKIE_SECURE=false

# --- Existing service and Google login configuration ---
TAVILY_API_KEY=replace-me
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=

# --- Session and integration encryption ---
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=session
SESSION_TTL_S=604800
OAUTH_STATE_TTL_S=600
OAUTH_STATE_COOKIE_SALT=google-oauth-state-v1
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
INTEGRATIONS_ENABLED=true
INTEGRATION_OAUTH_STATE_TTL_S=600
INTEGRATION_OAUTH_STATE_COOKIE_SALT=integration-oauth-state-v1

# --- GitHub OAuth, backend only ---
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user,repo

# --- GitLab OAuth, backend only ---
# Read-only identity access is the default. `api` is accepted only when writes are explicitly enabled.
GITLAB_OAUTH_CLIENT_ID=replace-me
GITLAB_OAUTH_CLIENT_SECRET=replace-me
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/gitlab/callback
GITLAB_OAUTH_SCOPES=read_user
GITLAB_REPOSITORY_WRITE_ENABLED=false
GITLAB_AUTHORIZE_URL=https://gitlab.com/oauth/authorize
GITLAB_TOKEN_URL=https://gitlab.com/oauth/token
GITLAB_USER_URL=https://gitlab.com/api/v4/user

POST_LOGIN_REDIRECT_URL=http://localhost:3000/

VLLM_ENDPOINT=http://127.0.0.1:8001/v1
VLLM_HEALTH_ENDPOINT=http://127.0.0.1:8001/health